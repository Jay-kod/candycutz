{
  "name": "candycutz-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-runner.mjs",
    "dev:api": "node scripts/start-api.mjs",
    "dev:web": "cd barbing-saloon-web && npm run dev",
    "dev:windows": "start cmd /k \"npm run dev:api\" && start cmd /k \"npm run dev:web\"",
    "prepare": "git config core.hooksPath .githooks 2>nul || true",
    "audit:responsive": "cd barbing-saloon-web && npm run audit:responsive",
    "test:responsive": "cd barbing-saloon-web && npm run test:responsive"
  },
  "dependencies": {
    "playwright": "^1.61.0"
  }
}
