APP_NAME=CandyCutz
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
LOG_CHANNEL=stderr

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=candycutz_db
DB_USERNAME=candycutz
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Resend Transactional Email
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="no-reply@mail.yourdomain.com"
MAIL_FROM_NAME="Candycutz"

# Persistent Cloud Object Storage (Cloudflare R2 / AWS S3)
FILESYSTEM_DISK=public
