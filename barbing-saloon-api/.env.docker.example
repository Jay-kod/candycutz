APP_NAME=CandyCutz
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Lagos
LOG_CHANNEL=stderr

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=candycutz_db
DB_USERNAME=candycutz
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Resend Transactional Email
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="no-reply@mail.yourdomain.com"
MAIL_FROM_NAME="Candycutz"

# Payment Processing (Paystack Primary, Manual Transfer Fallback)
PAYMENT_GATEWAY=paystack
PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_WITH_LIVE_KEY
PAYSTACK_SECRET_KEY=sk_live_REPLACE_WITH_LIVE_SECRET
PAYSTACK_CALLBACK_URL=https://candycutz.com/api/v1/payments/return

# Manual Bank Transfer Defaults (Nigerian In-Market Fallback)
MANUAL_TRANSFER_BANK="Zenith Bank"
MANUAL_TRANSFER_ACCOUNT_NAME="CandyCutz Luxury Grooming"
MANUAL_TRANSFER_ACCOUNT_NUMBER="1010101010"

# Sanctum & CORS
SANCTUM_STATEFUL_DOMAINS=candycutz.com,admin.candycutz.com,localhost
SESSION_SECURE_COOKIE=true
CORS_ALLOWED_ORIGINS=https://candycutz.com,https://admin.candycutz.com

# Persistent Cloud Object Storage (Cloudflare R2 / AWS S3)
FILESYSTEM_DISK=public
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=candycutz-media
# AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_URL=https://<public-r2-domain>
