# ==============================================================================
# Candycutz — Single-VPS Production Environment Blueprint
# Copy to .env on VPS host and configure strong secrets before running docker compose
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Identity & Security
# ------------------------------------------------------------------------------
APP_NAME="CandyCutz Luxury Grooming"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://candycutz.com

# ------------------------------------------------------------------------------
# 2. Database (MySQL 8.0 Internal Container)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=candycutz_db
DB_USERNAME=candycutz
DB_PASSWORD=REPLACE_WITH_VERY_STRONG_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_VERY_STRONG_ROOT_PASSWORD

# ------------------------------------------------------------------------------
# 3. Redis (Cache, Sessions, & Queues)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_STORE=redis
CACHE_PREFIX=candycutz_cache_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.candycutz.com
QUEUE_CONNECTION=redis

# ------------------------------------------------------------------------------
# 4. State & Authentication (Sanctum & CORS)
# ------------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=candycutz.com,www.candycutz.com,admin.candycutz.com
SESSION_SECURE_COOKIE=true
CORS_ALLOWED_ORIGINS=https://candycutz.com,https://www.candycutz.com,https://admin.candycutz.com

# ------------------------------------------------------------------------------
# 5. Storage & Filesystem
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=public

# ------------------------------------------------------------------------------
# 6. Transactional Mail (Brevo / SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_BREVO_SMTP_LOGIN
MAIL_PASSWORD=REPLACE_WITH_BREVO_SMTP_KEY
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=bookings@candycutz.com
MAIL_FROM_NAME="CandyCutz Barbing Saloon"

# ------------------------------------------------------------------------------
# 7. Payment Processing (Stripe)
# ------------------------------------------------------------------------------
STRIPE_KEY=pk_live_REPLACE_WITH_LIVE_KEY
STRIPE_SECRET=sk_live_REPLACE_WITH_LIVE_SECRET
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# 8. Mobile & Expo Push Notifications
# ------------------------------------------------------------------------------
EXPO_ACCESS_TOKEN=REPLACE_WITH_EXPO_ACCESS_TOKEN

# ------------------------------------------------------------------------------
# 9. Docker Host Ingress Ports
# ------------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
