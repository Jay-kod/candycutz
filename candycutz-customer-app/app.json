{
  "expo": {
    "name": "CandyCutz",
    "slug": "candycutz-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F2E8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.candycutz.customer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9F2E8"
      },
      "package": "com.candycutz.customer"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "scheme": "candycutz",
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
